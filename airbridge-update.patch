+            UpdateState.Current -> "You're up to date."
+            is UpdateState.Available -> "AirBridge ${current.version} is available."
+            is UpdateState.Downloading -> "Downloading AirBridge ${current.version}…"
+            UpdateState.Ready -> "Update downloaded. Allow installs from AirBridge if asked, then select Install again."
