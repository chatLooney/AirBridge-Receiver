@@ -0,0 +1,8 @@
+package com.cressu.screendock.renderer
+
+/** Timing policy shared by the renderer and JVM regression tests. */
+internal object AudioTimeline {
+    fun needsReset(driftNs: Long, extraDelayMs: Int): Boolean =
+        driftNs > 80_000_000L ||
+            driftNs < -250_000_000L - extraDelayMs.coerceIn(0, 250) * 1_000_000L
+}
