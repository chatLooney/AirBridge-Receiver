diff --git a/app/src/test/java/com/cressu/screendock/renderer/AudioTimelineTest.kt b/app/src/test/java/com/cressu/screendock/renderer/AudioTimelineTest.kt
new file mode 100644
index 0000000..ef09d31
--- /dev/null
+++ b/app/src/test/java/com/cressu/screendock/renderer/AudioTimelineTest.kt
@@ -0,0 +1,24 @@
+package com.cressu.screendock.renderer
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AudioTimelineTest {
+    @Test fun normalJitterKeepsTimeline() {
+        assertFalse(AudioTimeline.needsReset(-40_000_000L, 0))
+        assertFalse(AudioTimeline.needsReset(40_000_000L, 0))
+    }
+    @Test fun lateAudioRecoversWithoutDroppingCompressedPackets() {
+        assertFalse(AudioTimeline.needsReset(80_000_000L, 0))
+        assertTrue(AudioTimeline.needsReset(80_000_001L, 0))
+    }
+    @Test fun forwardAndBackwardSeeksResetTimeline() {
+        assertTrue(AudioTimeline.needsReset(-5_000_000_000L, 0))
+        assertTrue(AudioTimeline.needsReset(5_000_000_000L, 0))
+    }
+    @Test fun manualDelayDoesNotLookLikeSeek() {
+        assertFalse(AudioTimeline.needsReset(-400_000_000L, 250))
+        assertTrue(AudioTimeline.needsReset(-500_000_001L, 250))
+    }
+}
diff --git a/app/src/test/java/com/cressu/screendock/settings/PlaybackTuningTest.kt b/app/src/test/java/com/cressu/screendock/settings/PlaybackTuningTest.kt
new file mode 100644
index 0000000..c3da3be
--- /dev/null
+++ b/app/src/test/java/com/cressu/screendock/settings/PlaybackTuningTest.kt
@@ -0,0 +1,31 @@
+package com.cressu.screendock.settings
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class PlaybackTuningTest {
+    @Test fun `late audio is corrected by delaying only the picture`() {
+        assertEquals(150, PlaybackTuning.videoDelayMs(-150))
+        assertEquals(0, PlaybackTuning.audioDelayMs(-150))
+    }
+
+    @Test fun `early audio is corrected by delaying only sound`() {
+        assertEquals(150, PlaybackTuning.audioDelayMs(150))
+        assertEquals(0, PlaybackTuning.videoDelayMs(150))
+    }
+
+    @Test fun `corrupt settings cannot schedule unbounded delay`() {
+        assertEquals(250, PlaybackTuning.videoDelayMs(Int.MIN_VALUE))
+        assertEquals(250, PlaybackTuning.audioDelayMs(Int.MAX_VALUE))
+    }
+
+    @Test fun `presets preserve receiver identity and sync adjustment`() {
+        val custom = AirPlaySettings(displayName = "Living room", audioSyncOffsetMs = -100)
+        for (preset in ConnectionPreset.entries) {
+            val settings = preset.applyTo(custom)
+            assertEquals("Living room", settings.displayName)
+            assertEquals(-100, settings.audioSyncOffsetMs)
+            assertEquals(60, settings.maxFps)
+        }
+    }
+}
diff --git a/app/src/test/java/com/cressu/screendock/update/AppUpdaterVersionTest.kt b/app/src/test/java/com/cressu/screendock/update/AppUpdaterVersionTest.kt
new file mode 100644
index 0000000..235b137
--- /dev/null
+++ b/app/src/test/java/com/cressu/screendock/update/AppUpdaterVersionTest.kt
@@ -0,0 +1,17 @@
+package com.cressu.screendock.update
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class AppUpdaterVersionTest {
+    @Test fun `release tags use Android version codes not build retry numbers`() {
+        assertEquals(10L, AppUpdater.versionCode("v0.3.6-vc10"))
+        assertEquals(9L, AppUpdater.versionCode("v0.3.5-vc9-build99"))
+    }
+
+    @Test fun `missing or malformed version codes cannot offer an update`() {
+        for (tag in listOf("v99.0", "v0.3.6-vc", "v0.3.6-vc10bad", "v0.3.6-vc999999999999999999999")) {
+            assertEquals(tag, 0L, AppUpdater.versionCode(tag))
+        }
+    }
+}
