@@ -0,0 +1,17 @@
+package com.cressu.screendock.settings
+
+/** Positive offset delays sound; negative offset delays the picture for late sound. */
+object PlaybackTuning {
+    fun audioDelayMs(offsetMs: Int): Int = offsetMs.coerceIn(0, 250)
+    fun videoDelayMs(offsetMs: Int): Int = (-offsetMs.coerceIn(-250, 250)).coerceAtLeast(0)
+}
+
+enum class ConnectionPreset(val label: String, val width: Int, val height: Int, val h265: Boolean) {
+    LOW_DELAY("Low delay · 720p", 1280, 720, false),
+    BALANCED("Balanced · 1080p", 1920, 1080, true),
+    BEST_QUALITY("Best quality · 4K", 3840, 2160, true);
+
+    fun applyTo(settings: AirPlaySettings) = settings.copy(
+        maxWidth = width, maxHeight = height, maxFps = 60, h265Enabled = h265,
+    )
+}
